DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=your-personal-access-token

# ── Data store (where parquet files live) ─────────────────
# Pick one: local | s3 | azure | gcs
DATA_STORE=local

# --- local (default) ---
# Filesystem path; used when DATA_STORE=local.
DATA_DIR=data

# --- s3 ---
# DATA_S3_BUCKET=my-billing-bucket
# DATA_S3_PREFIX=                      # optional (e.g. "billing/exports")
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=                   # omit if using IAM role / IMDS
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=                   # if using temp creds
# AWS_S3_ENDPOINT_URL=                 # for MinIO / non-AWS S3 only

# --- azure ---
# DATA_AZURE_ACCOUNT=mystorageacct
# DATA_AZURE_CONTAINER=billing-data
# DATA_AZURE_PREFIX=                   # optional
# AZURE_STORAGE_CONNECTION_STRING=     # easiest auth for dev
# AZURE_STORAGE_ACCOUNT_KEY=           # alternative to connection string

# --- gcs ---
# DATA_GCS_BUCKET=my-billing-bucket
# DATA_GCS_PREFIX=                     # optional
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# DuckDB reads GCS via the S3-compatible HMAC gateway:
# GCS_HMAC_ACCESS_KEY=
# GCS_HMAC_SECRET_KEY=


# ── LLM API Keys (optional – users can supply per-request) ──
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Azure OpenAI ───────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# ── Self-hosted: vLLM (OpenAI-compatible /v1) ──────────────
# Set VLLM_BASE_URL to your vLLM server. /v1 will be appended if missing.
VLLM_BASE_URL=http://localhost:8000
# vLLM accepts any string when --api-key isn't set. Override if you launched
# the server with --api-key <key>.
VLLM_API_KEY=EMPTY

# ── Self-hosted: Ollama (OpenAI-compatible /v1) ────────────
OLLAMA_HOST=http://localhost:11434

# ── Auth ──────────────────────────────────────────────────
# JWT signing secret. CHANGE THIS in production.
JWT_SECRET=please-change-me-to-a-long-random-secret-in-production
JWT_TTL_HOURS=24
# Frontend base URL (used in verification links and OAuth callback redirect)
APP_BASE_URL=http://localhost:3000
# Backend public URL (used to build OAuth redirect_uri). Optional;
# falls back to the request host. Set this when running behind a proxy.
OAUTH_BACKEND_BASE_URL=

# Bootstrap admin (optional): if set, a verified admin user is created on startup.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
# Local dev convenience: pre-fill the login form with the bootstrap admin
# above so you don't have to type credentials. NEVER enable in prod.
EXPOSE_DEV_CREDENTIALS=false

# ── Email (AWS SES) ───────────────────────────────────────
# When BOTH are set, verification emails go via SES. Otherwise the link is
# logged to backend stdout for development.
AWS_REGION=us-east-1
SES_FROM_EMAIL=
# AWS credentials (or use IAM role / instance profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── OAuth (Google / Microsoft / GitHub) ───────────────────
# Each provider's authorize button is hidden if its client id is missing.
# Redirect/callback URIs to register with each provider:
#   Google:    {APP_BASE_URL}/oauth/callback   (frontend handles)
#   Backend:   {OAUTH_BACKEND_BASE_URL or backend host}/api/auth/oauth/<provider>/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
